---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslation } from '../i18n/ui';
import { Image } from 'astro:assets';
import simulatorShot from '../assets/liz/simulator.png';
import dashboardShot from '../assets/liz/dashboard.png';

const locale = 'en' as const;
const pathname = '/liz';
const t = useTranslation(locale);

const shots = [
  { img: simulatorShot, alt: 'Liz conversation simulator', caption: 'FIG. 1 — CONVERSATION SIMULATOR' },
  { img: dashboardShot, alt: 'Liz clinic dashboard', caption: 'FIG. 2 — CLINIC DASHBOARD' },
];
---

<BaseLayout
  title="Liz — Augusto Amaral"
  description="Liz — a WhatsApp assistant for a medical practice, in production. Bun, Hono, Claude, Whisper."
  locale={locale}
  pathname={pathname}
  activeNav="liz"
>

  <section class="liz-top section-border">
    <div class="container">
      <div class="liz-label-row">
        <p class="page-label mono-label">{t('liz.label')}</p>
        <span class="beta-tag">{t('liz.statusBadge')}</span>
      </div>
      <h1 class="liz-h1">{t('liz.h1')}</h1>
      <p class="liz-tagline">
        A WhatsApp assistant that answers a medical practice's patients — <em>in production, every day</em>.
      </p>
    </div>
  </section>

  <section class="liz-what section-border">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 class="sub-h2">{t('liz.whatTitle')}</h2>
          <p class="sub-body">
            Liz is the virtual assistant of a pediatric gastroenterology practice. Patients message the clinic on WhatsApp; Liz answers — clinic info, scheduling, general questions — and hands the conversation to a human whenever it should.
          </p>
        </div>
        <div>
          <h2 class="sub-h2">{t('liz.howTitle')}</h2>
          <p class="sub-body">
            Text messages get answered directly. Audio gets transcribed and answered. Scheduling intent is detected and preferences are collected against a real calendar. Behind it: Bun, Hono, PostgreSQL, whatsapp-web.js, Claude for replies, Whisper for audio, Google Calendar for scheduling — plus a Chrome extension that puts a management panel inside WhatsApp Web, and a React dashboard for the clinic team. Runs on Docker, on an ARM box.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="liz-shots section-border">
    <div class="container">
      <h2 class="data-title">In practice</h2>
      <div class="shots-grid">
        {shots.map((s) => (
          <figure class="shot">
            <Image src={s.img} alt={s.alt} width={900} class="shot-img" />
            <figcaption class="mono-label">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="liz-data section-border">
    <div class="container">
      <h2 class="data-title">{t('liz.dataTitle')}</h2>
      <div class="data-table">
        <div class="data-header">
          <span class="mono-label">DATA</span>
          <span class="mono-label">WHY</span>
          <span class="mono-label">SHARED?</span>
        </div>
        <div class="data-row">
          <span class="row-data">Email</span>
          <span class="row-why">Auth + digest delivery</span>
          <span class="row-shared no">No</span>
        </div>
        <div class="data-row">
          <span class="row-data">Session metadata</span>
          <span class="row-why">Product works</span>
          <span class="row-shared no">No</span>
        </div>
        <div class="data-row">
          <span class="row-data">Error logs</span>
          <span class="row-why">Fix bugs</span>
          <span class="row-shared">Sentry, scrubbed</span>
        </div>
      </div>
      <p class="data-note">
        <a href="/privacy#liz" class="inline-link">{t('liz.privacyLink')}</a>
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .liz-top {
    padding: 80px 0;
  }

  .liz-label-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .page-label {
    margin: 0;
    letter-spacing: 0.12em;
  }

  .beta-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--accent-warm);
    border: 1px solid var(--accent-warm);
    padding: 2px 8px;
  }

  .liz-h1 {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
    margin: 0 0 var(--space-5) 0;
    letter-spacing: -0.02em;
  }

  .liz-tagline {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.5;
    margin: 0;
    max-width: 640px;
    color: var(--fg-muted);
  }

  .liz-tagline em {
    font-style: italic;
    color: var(--fg-primary);
  }

  .liz-what {
    padding: 80px 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .sub-h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    margin: 0 0 var(--space-4) 0;
  }

  .sub-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
  }

  .liz-data {
    padding: 80px 0;
  }

  .data-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    margin: 0 0 32px 0;
  }

  .data-table {
    border-top: 1px solid var(--border);
    margin-bottom: 24px;
  }

  .data-header,
  .data-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .data-header {
    border-bottom: 1px solid var(--fg-muted);
  }

  .row-data {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-primary);
  }

  .row-why {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .row-shared {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .row-shared.no {
    color: var(--fg-primary);
  }

  .data-note {
    margin: 16px 0 0 0;
  }

  .inline-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .inline-link:hover {
    color: var(--fg-primary);
    border-color: var(--fg-primary);
  }

  .liz-shots {
    padding: 80px 0;
  }

  .shots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 32px;
    margin-top: 32px;
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shot-img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border);
  }

  @media (max-width: 720px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
