---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslation } from '../i18n/ui';

const locale = 'en' as const;
const pathname = '/shelf';
const t = useTranslation(locale);

const snippets = [
  { kind: 'snippet', name: 'git-clean-branches', about: 'Deletes local branches whose remote is gone. One alias: clb.', date: '2026 · 08', href: '/shelf/clean-branches' },
];
---

<BaseLayout
  title="Shelf — Augusto Amaral"
  description="Snippets, demos, half-essays. Some are useful. None are a product."
  locale={locale}
  pathname={pathname}
  activeNav="shelf"
>

  <section class="shelf-top section-border">
    <div class="container">
      <p class="page-label mono-label">{t('shelf.label')}</p>
      <h1 class="page-h1">
        A public bookshelf of <em>small things I made</em>.
      </h1>
      <p class="page-intro">{t('shelf.intro')}</p>
    </div>
  </section>

  <section class="shelf-systems">
    <div class="container">
      <h2 class="zone-title mono-label">{t('shelf.systemsTitle')}</h2>
    </div>
    <div class="index-list">
      <a href="/shelf/claude" class="index-row">
        <div class="container index-row-inner">
          <span class="idx-num mono-label">I</span>
          <span class="idx-title">How I use Claude</span>
          <span class="idx-desc">The rules, the aliases, the safety posture, the other models.</span>
          <span class="idx-arrow">→</span>
        </div>
      </a>
      <a href="/shelf/second-brain" class="index-row">
        <div class="container index-row-inner">
          <span class="idx-num mono-label">II</span>
          <span class="idx-title">Second brain</span>
          <span class="idx-desc">Two vaults written by agents, for agents. One runs itself at night.</span>
          <span class="idx-arrow">→</span>
        </div>
      </a>
    </div>
  </section>

  <section class="shelf-table">
    <div class="container">
      <h2 class="zone-title mono-label">{t('shelf.snippetsTitle')}</h2>
    </div>
    <div class="table-header">
      <div class="container table-row-inner">
        <span class="col-kind mono-label">KIND</span>
        <span class="col-name mono-label">NAME</span>
        <span class="col-about mono-label">ABOUT</span>
        <span class="col-date mono-label">DATE</span>
        <span class="col-arrow"></span>
      </div>
    </div>
    {snippets.map((item) => (
      <a href={item.href} class="table-row">
        <div class="container table-row-inner">
          <span class="col-kind row-kind mono-label">{item.kind}</span>
          <span class="col-name row-name">{item.name}</span>
          <span class="col-about row-about">{item.about}</span>
          <span class="col-date row-date mono-label">{item.date}</span>
          <span class="col-arrow row-arrow">→</span>
        </div>
      </a>
    ))}
  </section>

</BaseLayout>

<style>
  .shelf-top {
    padding: 80px 0;
  }

  .page-label {
    margin: 0 0 24px 0;
    letter-spacing: 0.12em;
  }

  .page-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.0;
    margin: 0 0 var(--space-5) 0;
    letter-spacing: -0.02em;
  }

  .page-h1 em {
    font-style: italic;
    color: var(--fg-muted);
  }

  .page-intro {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin: 0;
  }

  .zone-title {
    margin: 48px 0 16px;
    letter-spacing: 0.12em;
  }

  .index-list {
    display: flex;
    flex-direction: column;
  }

  .index-row {
    display: block;
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s;
  }

  .index-row:hover {
    background-color: var(--bg-elevated);
  }

  .index-row-inner {
    display: grid;
    grid-template-columns: 60px 1fr 380px 60px;
    gap: 16px;
    align-items: center;
  }

  .idx-num {
    letter-spacing: 0.08em;
  }

  .idx-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
  }

  .idx-desc {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .idx-arrow {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--fg-muted);
    text-align: right;
  }

  .shelf-table {
    padding: 0 0 80px;
  }

  .table-header,
  .table-row {
    display: block;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
  }

  .table-header {
    border-bottom: 1px solid var(--fg-muted);
  }

  .table-row {
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s;
  }

  .table-row:hover {
    background-color: var(--bg-elevated);
  }

  .table-row-inner {
    display: grid;
    grid-template-columns: 120px 240px 1fr 120px 60px;
    gap: 16px;
    align-items: center;
  }

  .row-kind {
    color: var(--fg-muted);
    letter-spacing: 0.08em;
  }

  .row-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-primary);
  }

  .row-about {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .row-date {
    color: var(--fg-muted);
    letter-spacing: 0.06em;
  }

  .row-arrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    text-align: right;
  }

  @media (max-width: 960px) {
    .index-row-inner {
      grid-template-columns: 40px 1fr 40px;
    }

    .idx-desc {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .table-row-inner {
      grid-template-columns: 80px 1fr 60px;
    }

    .col-about,
    .col-date {
      display: none;
    }
  }
</style>
