---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslation } from '../i18n/ui';
import { Image } from 'astro:assets';
import springPhoto from '../assets/experiences/spring.png';
import three60Photo from '../assets/experiences/three60.jpg';
import zoolatechPhoto from '../assets/experiences/zoolatech.jpg';
import avalieiPhoto from '../assets/experiences/avaliei.jpg';
import odsPhoto from '../assets/experiences/ods.jpg';

const locale = 'en' as const;
const pathname = '/experiences';
const t = useTranslation(locale);

const chapters = [
  {
    num: 'I',
    years: '2026 — now',
    company: 'Spring Health',
    role: 'Senior Software Engineer',
    body: 'Mental health care, at scale. I own provider scheduling features end to end, scoped directly with product and built across React/TypeScript and Rails/GraphQL, now live for 1,000+ providers. Along the way: A/B experiments (one drove a +57% lift in provider engagement) and on-call for the in-house video platform.',
    fig: 'FIG. I.1 — SPRING HEALTH',
    photo: springPhoto,
    alt: 'Spring Health logo',
  },
  {
    num: 'II',
    years: '2024 — 2025',
    company: 'Three60 Energy / Maiella',
    role: 'Senior Software Engineer & Team Lead',
    body: 'BI dashboards for the oil & gas industry, with a team split between Norway and Italy. I led a three-person frontend team, built the design system in Storybook, wired end-to-end type safety with Elysia and Eden Treaty, and replaced Chromatic with a Playwright visual testing setup that cut that bill by 80%.',
    fig: 'FIG. II.1 — THREE60 TEAM',
    photo: three60Photo,
    alt: 'Three60 Energy team photo',
  },
  {
    num: 'III',
    years: '2022 — 2024',
    company: 'Procore (via Zoolatech)',
    role: 'Software Engineer (Consultant)',
    body: 'Construction software, used by people who actually wear hard hats. As a consultant through Zoolatech, I worked on a 20-year-old Rails and React platform: raised test coverage by 37%, cut module load time by 23% with code splitting, shipped budget-management features, and won an internal hackathon.',
    fig: 'FIG. III.1 — ZOOLATECH TEAM',
    photo: zoolatechPhoto,
    alt: 'Zoolatech team photo',
  },
  {
    num: 'IV',
    years: '2021 — 2022',
    company: 'Avaliei!',
    role: 'CTO & Co-founder',
    body: 'It started as a Hacking.Rio 2019 project that made the finals among 700+ participants. I became technical co-founder and built the product from zero, in partnership with Vibra Energia: full-stack architecture, serverless infrastructure, and automated pipelines on a near-zero budget. The startup didn\'t last, but owning a product end to end started here.',
    fig: 'FIG. IV.1 — AVALIEI!',
    photo: avalieiPhoto,
    alt: 'Group photo from the Avaliei! days',
  },
  {
    num: 'V',
    years: '2019 — 2022',
    company: 'ODS (Odda Digital System)',
    role: 'Frontend → Full-stack Developer',
    body: 'My first engineering job, remote, for a Norwegian company. I started on the frontend and moved to full stack within six months: a GraphQL gateway over several backend services, Node and Rails microservices, and an Azure Service Bus automation that replaced manual ERP data entry.',
    fig: 'FIG. V.1 — ODS TEAM',
    photo: odsPhoto,
    alt: 'ODS team photo',
  },
];
---

<BaseLayout
  title="Experiences — Augusto Amaral"
  description="Five chapters, seven years, told as a story. From ODS to Spring Health."
  locale={locale}
  pathname={pathname}
  activeNav="experiences"
>

  <section class="exp-top section-border">
    <div class="container">
      <p class="page-label mono-label">{t('experiences.label')}</p>
      <h1 class="page-h1">
        Five chapters, seven years, told <em>as a story</em>.
      </h1>
      <p class="page-intro">
        {t('experiences.intro')} <a href="https://resume.augustoamaral.com" class="inline-link" target="_blank" rel="noopener">resume.augustoamaral.com ↗</a>.
      </p>
    </div>
  </section>

  {chapters.map((ch) => (
    <section class="chapter section-border">
      <div class="container">
        <div class="chapter-grid">
          <div class="chapter-left">
            <span class="ch-num mono-label">{ch.num}</span>
            <span class="ch-years mono-label">{ch.years}</span>
          </div>
          <div class="chapter-mid">
            <h2 class="ch-company">{ch.company}</h2>
            <p class="ch-role mono-label">{ch.role}</p>
            <p class="ch-body">{ch.body}</p>
          </div>
          <div class="chapter-right">
            <figure class="ch-photo">
              <Image src={ch.photo} alt={ch.alt} width={800} class="ch-photo-img" />
              <figcaption class="ch-photo-label mono-label">{ch.fig}</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>
  ))}

</BaseLayout>

<style>
  .exp-top {
    padding: 80px 0;
  }

  .page-label {
    margin: 0 0 24px 0;
    letter-spacing: 0.12em;
  }

  .page-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.0;
    margin: 0 0 var(--space-5) 0;
    letter-spacing: -0.02em;
  }

  .page-h1 em {
    font-style: italic;
    color: var(--fg-muted);
  }

  .page-intro {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin: 0;
  }

  .inline-link {
    color: var(--fg-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }

  .inline-link:hover {
    border-color: var(--fg-primary);
  }

  .chapter {
    padding: 80px 0;
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: 80px 1fr 1fr;
    gap: 40px;
  }

  .chapter-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 6px;
  }

  .ch-num {
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .ch-years {
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .chapter-mid {}

  .ch-company {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 8px 0;
    line-height: 1.1;
  }

  .ch-role {
    margin: 0 0 20px 0;
    letter-spacing: 0.08em;
  }

  .ch-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg-muted);
    margin: 0;
  }

  .chapter-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ch-photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ch-photo-img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    display: block;
  }

  .ch-photo-label {
    letter-spacing: 0.1em;
  }

  @media (max-width: 720px) {
    .chapter-grid {
      grid-template-columns: 1fr;
    }

    .chapter-left {
      flex-direction: row;
      gap: 16px;
    }
  }
</style>
