---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/ui';

const locale = 'pt' as const;
const pathname = '/pt/channel';
const t = useTranslation(locale);
---

<BaseLayout
  title="Canal — O Dev Guto — Augusto Amaral"
  description="O Dev Guto — engenharia de software em português. Sem thumbnails gritantes."
  locale={locale}
  pathname={pathname}
  activeNav="channel"
>

  <section class="channel-top section-border">
    <div class="container">
      <p class="page-label mono-label">{t('channel.label')}</p>
      <h1 class="page-h1">{t('channel.h1')}</h1>
      <p class="page-intro">
        Engenharia de software em português. <em>Sem</em> thumbnails gritantes, <em>sem</em> '10 coisas que você não sabia sobre React', <em>com</em> as partes que tive que descobrir do jeito difícil.
      </p>
    </div>
  </section>

  <section class="channel-why section-border">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 class="sub-h2">{t('channel.whyTitle')}</h2>
          <p class="sub-body">
            Porque passei horas demais assistindo conteúdo só em inglês quando estava aprendendo, e toda vez que alguém mudava para meu idioma o material ficava mais raso. Não precisa ser assim. Boas explicações não precisam de um segundo idioma.
          </p>
        </div>
        <div>
          <h2 class="sub-h2">{t('channel.whatTitle')}</h2>
          <p class="sub-body">
            Mergulhos profundos em problemas reais de engenharia: gerenciamento de estado, internos do TypeScript, debugging em produção, sistemas de design. Não tutoriais. Não "top 10 hooks". O trabalho de verdade, mostrado com honestidade.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="channel-link-out">
    <div class="container">
      <a href="https://www.youtube.com/@odevguto" class="inline-link" target="_blank" rel="noopener">youtube.com/@odevguto ↗</a>
    </div>
  </section>

</BaseLayout>

<style>
  .channel-top {
    padding: 80px 0;
  }

  .page-label {
    margin: 0 0 24px 0;
    letter-spacing: 0.12em;
  }

  .page-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.0;
    margin: 0 0 var(--space-5) 0;
    letter-spacing: -0.02em;
  }

  .page-intro {
    font-size: 1rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 680px;
  }

  .page-intro em {
    font-style: italic;
    color: var(--fg-primary);
  }

  .channel-why {
    padding: 80px 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .sub-h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    margin: 0 0 var(--space-4) 0;
  }

  .sub-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
  }

  .inline-link {
    color: var(--fg-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }

  .inline-link:hover {
    border-color: var(--fg-primary);
  }

  .channel-link-out {
    padding: 0 0 80px;
  }

  @media (max-width: 720px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
