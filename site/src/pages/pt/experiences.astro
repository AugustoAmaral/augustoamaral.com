---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslation } from '../../i18n/ui';
import { Image } from 'astro:assets';
import springPhoto from '../../assets/experiences/spring.png';
import three60Photo from '../../assets/experiences/three60.jpg';
import zoolatechPhoto from '../../assets/experiences/zoolatech.jpg';
import avalieiPhoto from '../../assets/experiences/avaliei.jpg';
import odsPhoto from '../../assets/experiences/ods.jpg';

const locale = 'pt' as const;
const pathname = '/pt/experiences';
const t = useTranslation(locale);

const chapters = [
  {
    num: 'I',
    years: '2026 — agora',
    company: 'Spring Health',
    role: 'Senior Software Engineer',
    body: 'Cuidado com saúde mental, em escala. Sou dono de ponta a ponta das funcionalidades de agendamento de profissionais de saúde, definidas junto com o time de produto e construídas em React/TypeScript e Rails/GraphQL, hoje em produção para mais de 1.000 profissionais. No caminho: experimentos A/B (um deles gerou +57% de aumento no engajamento dos profissionais) e plantão para a plataforma de videochamada própria da empresa.',
    fig: 'FIG. I.1 — SPRING HEALTH',
    photo: springPhoto,
    alt: 'Logo da Spring Health',
  },
  {
    num: 'II',
    years: '2024 — 2025',
    company: 'Three60 Energy / Maiella',
    role: 'Senior Software Engineer & Team Lead',
    body: 'Dashboards de BI para a indústria de óleo e gás, com um time dividido entre Noruega e Itália. Liderei um time de três pessoas no frontend, construí o design system no Storybook, montei tipagem de ponta a ponta com Elysia e Eden Treaty, e substituí o Chromatic por uma configuração de testes visuais em Playwright que cortou esse custo em 80%.',
    fig: 'FIG. II.1 — THREE60 TEAM',
    photo: three60Photo,
    alt: 'Foto do time da Three60 Energy',
  },
  {
    num: 'III',
    years: '2022 — 2024',
    company: 'Procore (via Zoolatech)',
    role: 'Software Engineer (Consultor)',
    body: 'Software de construção civil, usado por gente que realmente usa capacete. Como consultor via Zoolatech, trabalhei numa plataforma Rails e React de 20 anos: aumentei a cobertura de testes em 37%, reduzi o tempo de carregamento de módulos em 23% com code splitting, entreguei funcionalidades de gestão de orçamento e venci um hackathon interno.',
    fig: 'FIG. III.1 — ZOOLATECH TEAM',
    photo: zoolatechPhoto,
    alt: 'Foto do time da Zoolatech',
  },
  {
    num: 'IV',
    years: '2021 — 2022',
    company: 'Avaliei!',
    role: 'CTO & Co-fundador',
    body: 'Começou como um projeto do Hacking.Rio 2019 que ficou entre os finalistas em meio a mais de 700 participantes. Me tornei cofundador técnico e construí o produto do zero, em parceria com a Vibra Energia: arquitetura full-stack, infraestrutura serverless e pipelines automatizados com um orçamento quase zero. A startup não deu certo, mas foi aí que comecei a ser dono de um produto de ponta a ponta.',
    fig: 'FIG. IV.1 — AVALIEI!',
    photo: avalieiPhoto,
    alt: 'Foto em grupo da época do Avaliei!',
  },
  {
    num: 'V',
    years: '2019 — 2022',
    company: 'ODS (Odda Digital System)',
    role: 'Frontend → Full-stack Developer',
    body: 'Meu primeiro emprego como engenheiro, remoto, para uma empresa norueguesa. Comecei no frontend e migrei para full stack em seis meses: um gateway GraphQL sobre vários serviços de backend, microsserviços em Node e Rails, e uma automação com Azure Service Bus que substituiu a digitação manual de dados no ERP.',
    fig: 'FIG. V.1 — ODS TEAM',
    photo: odsPhoto,
    alt: 'Foto do time da ODS',
  },
];
---

<BaseLayout
  title="Experiências — Augusto Amaral"
  description="Cinco capítulos, sete anos, contados como uma história. De ODS até Spring Health."
  locale={locale}
  pathname={pathname}
  activeNav="experiences"
>

  <section class="exp-top section-border">
    <div class="container">
      <p class="page-label mono-label">{t('experiences.label')}</p>
      <h1 class="page-h1">
        Cinco capítulos, sete anos, contados <em>como uma história</em>.
      </h1>
      <p class="page-intro">
        {t('experiences.intro')} <a href="https://resume.augustoamaral.com" class="inline-link" target="_blank" rel="noopener">resume.augustoamaral.com ↗</a>.
      </p>
    </div>
  </section>

  {chapters.map((ch) => (
    <section class="chapter section-border">
      <div class="container">
        <div class="chapter-grid">
          <div class="chapter-left">
            <span class="ch-num mono-label">{ch.num}</span>
            <span class="ch-years mono-label">{ch.years}</span>
          </div>
          <div class="chapter-mid">
            <h2 class="ch-company">{ch.company}</h2>
            <p class="ch-role mono-label">{ch.role}</p>
            <p class="ch-body">{ch.body}</p>
          </div>
          <div class="chapter-right">
            <figure class="ch-photo">
              <Image src={ch.photo} alt={ch.alt} width={800} class="ch-photo-img" />
              <figcaption class="ch-photo-label mono-label">{ch.fig}</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>
  ))}

</BaseLayout>

<style>
  .exp-top {
    padding: 80px 0;
  }

  .page-label {
    margin: 0 0 24px 0;
    letter-spacing: 0.12em;
  }

  .page-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.0;
    margin: 0 0 var(--space-5) 0;
    letter-spacing: -0.02em;
  }

  .page-h1 em {
    font-style: italic;
    color: var(--fg-muted);
  }

  .page-intro {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin: 0;
  }

  .inline-link {
    color: var(--fg-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }

  .inline-link:hover {
    border-color: var(--fg-primary);
  }

  .chapter {
    padding: 80px 0;
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: 80px 1fr 1fr;
    gap: 40px;
  }

  .chapter-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 6px;
  }

  .ch-num {
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .ch-years {
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .ch-company {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 8px 0;
    line-height: 1.1;
  }

  .ch-role {
    margin: 0 0 20px 0;
    letter-spacing: 0.08em;
  }

  .ch-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg-muted);
    margin: 0;
  }

  .chapter-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ch-photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ch-photo-img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    display: block;
  }

  .ch-photo-label {
    letter-spacing: 0.1em;
  }

  @media (max-width: 720px) {
    .chapter-grid {
      grid-template-columns: 1fr;
    }

    .chapter-left {
      flex-direction: row;
      gap: 16px;
    }
  }
</style>
