---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslation } from '../i18n/ui';

const locale = 'en' as const;
const pathname = '/channel';
const t = useTranslation(locale);
---

<BaseLayout
  title="Channel — O Dev Guto — Augusto Amaral"
  description="O Dev Guto — software engineering in Portuguese. Without shouting thumbnails."
  locale={locale}
  pathname={pathname}
  activeNav="channel"
>

  <section class="channel-top section-border">
    <div class="container">
      <p class="page-label mono-label">{t('channel.label')}</p>
      <h1 class="page-h1">{t('channel.h1')}</h1>
      <p class="page-intro">
        Engenharia de software em português. <em>Without</em> shouting thumbnails, <em>without</em> '10 things you didn't know about React', <em>with</em> the parts I had to figure out the hard way.
      </p>
    </div>
  </section>

  <section class="channel-why section-border">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 class="sub-h2">{t('channel.whyTitle')}</h2>
          <p class="sub-body">
            Because I spent too many hours watching English-only content when I was learning, and every time someone switched to my language the material got shallower. It doesn't have to be that way. Good explanations don't require a second language.
          </p>
        </div>
        <div>
          <h2 class="sub-h2">{t('channel.whatTitle')}</h2>
          <p class="sub-body">
            Deep dives into real engineering problems: state management, TypeScript internals, production debugging, design systems. Not tutorials. Not "top 10 hooks". The actual work, shown honestly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="channel-link-out">
    <div class="container">
      <a href="https://www.youtube.com/@odevguto" class="inline-link" target="_blank" rel="noopener">youtube.com/@odevguto ↗</a>
    </div>
  </section>

</BaseLayout>

<style>
  .channel-top {
    padding: 80px 0;
  }

  .page-label {
    margin: 0 0 24px 0;
    letter-spacing: 0.12em;
  }

  .page-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.0;
    margin: 0 0 var(--space-5) 0;
    letter-spacing: -0.02em;
  }

  .page-intro {
    font-size: 1rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 680px;
  }

  .page-intro em {
    font-style: italic;
    color: var(--fg-primary);
  }

  .channel-why {
    padding: 80px 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .sub-h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    margin: 0 0 var(--space-4) 0;
  }

  .sub-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
  }

  .inline-link {
    color: var(--fg-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }

  .inline-link:hover {
    border-color: var(--fg-primary);
  }

  .channel-link-out {
    padding: 0 0 80px;
  }

  @media (max-width: 720px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
